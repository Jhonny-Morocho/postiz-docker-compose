# Pegar en Dokploy > Compose > Environment (NO commitear .env real)
MAIN_URL=https://postiz.tudominio.com
JWT_SECRET=            # openssl rand -base64 48
POSTGRES_PASSWORD=     # openssl rand -hex 24
TEMPORAL_DB_PASSWORD=  # openssl rand -hex 24
DISABLE_REGISTRATION=false   # pon true tras crear tu cuenta
API_LIMIT=500

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Correo (opcional). SMTP: EMAIL_PROVIDER=nodemailer + HOST/PORT/USER/PASS/SECURE. Resend: RESEND_API_KEY (activa la verificación de cuentas)
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X_API_KEY= X_API_SECRET= LINKEDIN_* YOUTUBE_* THREADS_* OPENAI_API_KEY= (opcionales)
